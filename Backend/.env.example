# Backend/.env.example - copy to Backend/.env and fill in. NEVER commit .env.
PORT=3000
NODE_ENV=development

# --- Supabase project (ref: gbcxitpbiywmawbhykqr, region eu-west-1) ---
SUPABASE_URL=https://gbcxitpbiywmawbhykqr.supabase.co
# Server-side only (Storage signed URLs later). Rotate it if it was ever shared.
SUPABASE_SECRET_KEY=YOUR-NEW-SECRET-KEY

# Migrations + seed: role "postgres" through the SESSION pooler (port 5432, IPv4-friendly)
MIGRATION_DATABASE_URL=postgresql://postgres.gbcxitpbiywmawbhykqr:YOUR-DATABASE-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Password for the API role app_rw (pick a long random value; Db_Migrate creates the role with it)
APP_DB_PASSWORD=YOUR-APP-RW-PASSWORD
# Runtime: role app_rw through the TRANSACTION pooler (port 6543). Same password as APP_DB_PASSWORD.
DATABASE_URL=postgresql://app_rw.gbcxitpbiywmawbhykqr:YOUR-APP-RW-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=10

# Auth
JWT_ACCESS_SECRET=YOUR-RANDOM-64-CHAR-SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Test-only password used by Db_Seed for the synthetic users (owner, karim.adel, accountant)
SEED_USER_PASSWORD=Test_Pass_2026

# --- Security ---
# Supabase CA certificate (Dashboard -> Database -> SSL Configuration -> Download). REQUIRED in production.
DB_SSL_CA_PATH=
# Set to 1 when the API runs behind a load balancer / reverse proxy (real client IP for rate limits)
TRUST_PROXY=

# --- Admin Console API (platform) - runs as a SEPARATE process: npm run start:platform ---
PLATFORM_PORT=3001
# DB role for the admin API (Db_Migrate creates it). Same value inside PLATFORM_DATABASE_URL.
PLATFORM_DB_PASSWORD=YOUR-PLATFORM-RW-PASSWORD
PLATFORM_DATABASE_URL=postgresql://platform_rw.gbcxitpbiywmawbhykqr:YOUR-PLATFORM-RW-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Different from JWT_ACCESS_SECRET: a station token can never be used on the admin API (and vice versa)
PLATFORM_JWT_SECRET=YOUR-RANDOM-64-CHAR-PLATFORM-SECRET
# 32 bytes base64 - encrypts staff 2FA secrets
PLATFORM_ENCRYPTION_KEY=YOUR-32-BYTE-BASE64-KEY
# Comma-separated IPs allowed to call the admin API (empty = any, ONLY for local development)
PLATFORM_ALLOWED_IPS=
# Browser origins allowed to call the APIs (CORS)
ADMIN_SITE_ORIGIN=http://localhost:3003
PUBLIC_SITE_ORIGIN=http://localhost:3002
# Owner activation links point to the public website
PUBLIC_SITE_URL=http://localhost:3002

# Secret used ONLY to hash visitor IPs on the public request form (32+ random chars, required in production)
PUBLIC_IP_HASH_SECRET=YOUR-RANDOM-IP-HASH-SECRET

# Public website AI assistant (POST /v1/public/assistant). Leave empty to disable; the site then answers from its built-in FAQ.
ANTHROPIC_API_KEY=

# AES-256-GCM key for station secrets (staff 2FA secrets). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STATION_SECRETS_KEY=YOUR-32-BYTE-BASE64-KEY
