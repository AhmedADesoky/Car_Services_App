# Backend/.env.example - copy to Backend/.env and fill in. NEVER commit .env.
PORT=3000
NODE_ENV=development

# --- Supabase project (ref: gbcxitpbiywmawbhykqr, region eu-west-1) ---
SUPABASE_URL=https://gbcxitpbiywmawbhykqr.supabase.co
# Server-side only (Storage signed URLs later). Rotate it if it was ever shared.
SUPABASE_SECRET_KEY=YOUR-NEW-SECRET-KEY

# Migrations + seed: role "postgres" through the SESSION pooler (port 5432, IPv4-friendly)
MIGRATION_DATABASE_URL=postgresql://postgres.gbcxitpbiywmawbhykqr:YOUR-DATABASE-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Password for the API role app_rw (pick a long random value; Db_Migrate creates the role with it)
APP_DB_PASSWORD=YOUR-APP-RW-PASSWORD
# Runtime: role app_rw through the TRANSACTION pooler (port 6543). Same password as APP_DB_PASSWORD.
DATABASE_URL=postgresql://app_rw.gbcxitpbiywmawbhykqr:YOUR-APP-RW-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=10

# Auth
JWT_ACCESS_SECRET=YOUR-RANDOM-64-CHAR-SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Test-only password used by Db_Seed for the synthetic users (owner, karim.adel, accountant)
SEED_USER_PASSWORD=Test_Pass_2026
