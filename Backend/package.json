{
  "name": "car-services-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Car Services SaaS - Core API (NestJS + Supabase Postgres)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/Main.js",
    "typecheck": "tsc --noEmit",
    "Db_Migrate": "ts-node Database/Scripts/Run_Migrations.ts",
    "Db_Seed": "ts-node Database/Seeds/Seed_Three_Tenants.ts",
    "Db_Rls_Check": "ts-node Database/Scripts/Check_Rls_Coverage.ts",
    "test": "jest",
    "test:isolation": "jest Tests/Cross_Tenant",
    "start:platform": "nest start --watch --entryFile Platform/Platform_Main",
    "start:platform:prod": "node dist/Platform/Platform_Main.js",
    "Platform_Create_Super_Admin": "ts-node Database/Scripts/Create_Super_Admin.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*[.]spec[.]ts$",
    "transform": {
      "^.+[.]ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/throttler": "^6.8.0",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
