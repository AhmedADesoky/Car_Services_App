# Web_Admin/.env.local - server-only settings (never exposed to the browser)
# The Admin Console API (Backend: npm run start:platform). Private network / localhost only.
PLATFORM_API_URL=http://127.0.0.1:3001

# Number of trusted proxies in front of this site (0 in local dev). Controls which X-Forwarded-For entry is the real client IP.
TRUSTED_PROXY_HOPS=0
