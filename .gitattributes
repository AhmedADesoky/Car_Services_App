# One line-ending rule for everyone (Windows, macOS, Linux, Kaggle):
# text files are stored and checked out with LF, so git never rewrites them and diffs stay clean.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.zip binary
*.pt binary
*.onnx binary
*.tflite binary
